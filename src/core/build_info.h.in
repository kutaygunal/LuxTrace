// Generated by CMake at configure time. Do not edit.
//
// This is the build fingerprint: the identity of the exact binary that is
// running, so a diagnostics bundle can say which build produced a problem. The
// git commit is the most important line -- it is what lets a support engineer
// check out the code that made the report.

#pragma once

#define LUXTRACE_BUILD_VERSION    "@PROJECT_VERSION@"
#define LUXTRACE_BUILD_GIT_COMMIT "@LUXTRACE_GIT_COMMIT@"
#define LUXTRACE_BUILD_GIT_BRANCH "@LUXTRACE_GIT_BRANCH@"
#define LUXTRACE_BUILD_DATE       "@LUXTRACE_BUILD_DATE@"
#define LUXTRACE_BUILD_COMPILER   "@LUXTRACE_BUILD_COMPILER@"
#define LUXTRACE_BUILD_QT         "@LUXTRACE_BUILD_QT@"
#define LUXTRACE_BUILD_CUDA       "@LUXTRACE_BUILD_CUDA@"

// The build type (Release / Debug / RelWithDebInfo) is a per-configuration
// value on a multi-config generator, so it is supplied as a compile definition
// (LUXTRACE_BUILD_TYPE_STR) rather than baked in here.
